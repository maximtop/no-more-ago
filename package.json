{
  "name": "no-more-ago",
  "version": "0.1.0",
  "private": true,
  "description": "Replace trusted relative timestamps with exact dates.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/build.ts dev",
    "release": "node --experimental-strip-types scripts/build.ts release",
    "icons": "node --experimental-strip-types scripts/icons.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "locales:validate": "node --experimental-strip-types scripts/validate-locales.ts",
    "locales:audit": "node --experimental-strip-types scripts/audit-locales.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm locales:validate && pnpm test"
  },
  "dependencies": {
    "@adguard/translate": "2.0.8",
    "@date-fns/tz": "1.5.0",
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@xstate/react": "6.1.0",
    "date-fns": "4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valibot": "1.4.2",
    "xstate": "5.32.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@rspack/core": "2.1.10",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "0.2.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "commander": "15.0.0",
    "eslint": "10.9.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "fflate": "0.8.2",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
