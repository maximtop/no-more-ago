# Chrome Web Store credentials for local go-webext commands (make chrome_*).
# Copy to .env (gitignored) and fill in the values. Never commit .env.
# The same values are stored as GitHub Actions secrets and variables for
# .github/workflows/deploy-chrome-store.yml; see DEVELOPMENT.md.

# Extension ID from the Chrome Web Store Developer Dashboard item URL.
CHROME_APP_ID=

# OAuth 2.0 client with the Chrome Web Store API enabled and a refresh token
# granted for the https://www.googleapis.com/auth/chromewebstore scope.
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Publisher ID from the Developer Dashboard account page (API v2).
CHROME_PUBLISHER_ID=
CHROME_API_VERSION=v2
